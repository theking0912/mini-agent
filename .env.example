# ── Mini Agent 环境变量配置 ──────────────────────────────────
# 复制此文件为 .env 并填入实际值：
#   cp .env.example .env
#
# 💡 所有值都有合理默认值，不设置也能启动
# 💡 API Key 也可以通过 Web UI 的设置面板按用户配置
# 💡 不设 JWT_SECRET 则每次重启 token 失效，需重新登录

# ── LLM API Key（也可在 Web UI 里按用户设置） ────────────────
# DEEPSEEK_API_KEY=sk-xxx
# OPENAI_API_KEY=sk-xxx

# ── 数据库（PostgreSQL） ──────────────────────────────────────
PG_HOST=172.17.0.1
PG_PORT=5433
PG_USER=leroy
# PG_PASSWORD=your_password_here
PG_DATABASE=mini_agent

# ── 缓存（Redis） ─────────────────────────────────────────────
REDIS_HOST=172.17.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password

# ── JWT 签名密钥（不设则自动生成，重启后旧 token 失效） ──────
# JWT_SECRET=your-256-bit-secret

# ── 邮件（注册验证码，不设则验证码打印到日志） ────────────────
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=your@email.com
# EMAIL_SMTP_PASSWORD=your_smtp_password
# EMAIL_FROM_ADDR=noreply@mini-agent.app
